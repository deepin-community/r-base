From c0ff83e364561d123a244ac02aac6939874f4ee9 Mon Sep 17 00:00:00 2001
From: hudeng <hudeng@deepin.org>
Date: Mon, 3 Nov 2025 10:59:34 +0800
Subject: [PATCH] feat: deepin add sw64 support

---
 configure          | 9 ++++-----
 m4/gettext.m4      | 2 +-
 tools/config.guess | 3 +++
 tools/config.sub   | 1 +
 4 files changed, 9 insertions(+), 6 deletions(-)

diff --git a/configure b/configure
index 31c26ce..a2e32bc 100755
--- a/configure
+++ b/configure
@@ -29864,7 +29864,7 @@ if test "${GCC}" = yes; then
 ## However, although the gcc docs do not mention it, it seems s390/s390x
 ## also supports and needs -fPIC
 ## See <https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=1004747> for alpha.
-    aarch64*|alpha*|sparc*|ppc64*|powerpc64*|s390*)
+    aarch64*|alpha*|sparc*|ppc64*|powerpc64*|s390*|sw_64)
       cpicflags="-fPIC"
       ;;
     *)
@@ -29878,7 +29878,7 @@ fi
 ## Use same flang for gfortran as for gcc.
 if test "${ac_cv_fc_compiler_gnu}" = yes; then
   case "${host_cpu}" in
-    aarch64*|alpha*|sparc*|ppc64*|powerpc64*|s390*)
+    aarch64*|alpha*|sparc*|ppc64*|powerpc64*|s390*|sw_64)
       fpicflags="-fPIC"
       ;;
     *)
@@ -29909,7 +29909,7 @@ fi
 
 if test "${GXX}" = yes; then
   case "${host_cpu}" in
-    aarch64*|alpha*|sparc*|ppc64*|powerpc64*|s390*)
+    aarch64*|alpha*|sparc*|ppc64*|powerpc64*|s390*|sw_64)
       cxxpicflags="-fPIC"
       ;;
     *)
@@ -59734,7 +59734,7 @@ then :
 
           # Guess based on the CPU.
           case "$host_cpu" in
-            alpha* | i3456786 | m68k | s390*)
+            alpha* | i3456786 | m68k | s390*|sw_64)
               gt_cv_int_divbyzero_sigfpe="guessing yes";;
             *)
               gt_cv_int_divbyzero_sigfpe="guessing no";;
@@ -67347,4 +67347,3 @@ fi
 ### mode: outline-minor ***
 ### outline-regexp: "### [*]+" ***
 ### End: ***
-
diff --git a/m4/gettext.m4 b/m4/gettext.m4
index 157ef52..d05f574 100644
--- a/m4/gettext.m4
+++ b/m4/gettext.m4
@@ -635,7 +635,7 @@ int main ()
 ]])],[gt_cv_int_divbyzero_sigfpe=yes],[gt_cv_int_divbyzero_sigfpe=no],[
           # Guess based on the CPU.
           case "$host_cpu" in
-            alpha* | i[34567]86 | m68k | s390*)
+            alpha* | i[34567]86 | m68k | s390* | sw_64)
               gt_cv_int_divbyzero_sigfpe="guessing yes";;
             *)
               gt_cv_int_divbyzero_sigfpe="guessing no";;
diff --git a/tools/config.guess b/tools/config.guess
index 48a6846..36ad10b 100755
--- a/tools/config.guess
+++ b/tools/config.guess
@@ -1186,6 +1186,9 @@ EOF
     sparc:Linux:*:* | sparc64:Linux:*:*)
 	GUESS=$UNAME_MACHINE-unknown-linux-$LIBC
 	;;
+	sw_64:Linux:*:*)
+	GUESS=$UNAME_MACHINE-unknown-linux-$LIBC
+	;;
     tile*:Linux:*:*)
 	GUESS=$UNAME_MACHINE-unknown-linux-$LIBC
 	;;
diff --git a/tools/config.sub b/tools/config.sub
index 4aaae46..fc5419a 100755
--- a/tools/config.sub
+++ b/tools/config.sub
@@ -1430,6 +1430,7 @@ case $cpu-$vendor in
 			| sparcv9b \
 			| sparcv9v \
 			| spu \
+			| sw_64 \
 			| sv1 \
 			| sx* \
 			| tahoe \
-- 
2.50.1

